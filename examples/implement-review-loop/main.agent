// Flagship: deterministic bounded control around nondeterministic agents.
//
// An Implementer and an independent Reviewer pass a structured CodingState back
// and forth inside a bounded `while` — at most three implement/review rounds. The
// agents behave nondeterministically (which files they read, which permitted tools
// they call, what code or feedback they produce); Terfyn statically bounds the
// authority each may exercise, the number of iterations, and the reachable effects.
//
//   terfyn validate
//   terfyn plan
//   terfyn apply --auto-approve
//
// validate/plan/apply run offline on the mock model. Executing the loop needs a real
// model plus a sandbox for the workspace tool (TERFYN_WORKSPACE_ROOT +
// TERFYN_WORKSPACE_TEST_COMMAND) — see "Run it for real" in README.md, which also
// covers the capability boundary and the plan authority-widening walkthrough.
//
// Authored entirely in .agent (issue #430): the workspace tool, the two policies,
// both agents, and the workflow — no project.yaml. The `tests/capabilities.yaml`
// assertion (run by `terfyn test`) stays; the built-in `mock` provider and default
// `local` runtime are implicit.

tool workspace {
    type native
    safety {
        trusted true
        sideEffects true
    }
    operations {
        read_file { effects { workspace.read } }
        list_dir { effects { workspace.read } }
        glob { effects { workspace.read } }
        grep { effects { workspace.read } }
        run_tests { effects { process.exec } }
        write_file { effects { workspace.write } }
        edit { effects { workspace.write } }
    }
}

policy coding-agent {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
        // Raise the agent iteration ceiling above the default 32: a real implementation explores,
        // edits several files, runs tests, and fixes what fails in one attempt (issue #522). Cost and
        // wall-clock above still bound genuine runaways.
        maxIterations 64
    }
    effects {
        permit { workspace.read, workspace.write, process.exec }
    }
}

policy reviewer {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
    effects {
        permit { workspace.read, process.exec }
    }
}

agent Implementer {
    model mock/gpt-4
    policy coding-agent

    instructions """
    You are the implementation agent.

    You receive a CodingState describing a software engineering task and, on later
    attempts, review feedback from a previous implementation.

    Implement the requested change in the provided workspace. You may inspect files,
    modify files, and run tests using the capabilities granted to you. Prefer the cheap
    primitives: grep/glob to locate code, read_file with offset/limit to read just the
    relevant span, and edit (exact old_string -> new_string) for a small change rather
    than rewriting the whole file with write_file.

    If review feedback is present, address it before making unrelated changes.

    When finished, return the complete CodingState: preserve the original task,
    record a concise summary of what you changed, and do not claim tests passed
    unless you actually ran them successfully.
    """

    // A coding agent's write_file carries the whole new file as output tokens, so it
    // needs far more than the old 4096 default; raise the per-completion cap (issue #514).
    // It also asks for more reason→act turns to explore, edit, run tests, and fix in one
    // attempt: the request only takes effect because the coding-agent policy raises the
    // ceiling to 64 (issue #522) — the agent must declare the turns; the policy permits them.
    constraints {
        maxTokens 32000
        maxIterations 64
    }

    grants {
        tool.workspace.read_file
        tool.workspace.list_dir
        tool.workspace.glob
        tool.workspace.grep
        tool.workspace.write_file
        tool.workspace.edit
        tool.workspace.run_tests
    }

    input CodingState
    output CodingState
}

agent Reviewer {
    model mock/gpt-4
    policy reviewer

    instructions """
    You are the independent code reviewer.

    Inspect the implementation produced by the Implementer and determine whether it
    correctly satisfies the original task. You may inspect files and run tests. You
    must not modify the workspace.

    Review correctness, regressions, missing tests, unsafe behavior, and whether the
    implementation actually satisfies the requested change.

    Set approved to true only if the implementation is acceptable. If approved is
    false, populate feedback with concrete findings the Implementer can act on during
    the next attempt.

    Return the complete CodingState and preserve the original task.
    """

    grants {
        tool.workspace.read_file
        tool.workspace.list_dir
        tool.workspace.glob
        tool.workspace.grep
        tool.workspace.run_tests
    }

    input CodingState
    output CodingState
}

workflow ImplementAndReview(input: CodingState) -> CodingState
    effects {
        workspace.read,
        workspace.write,
        process.exec
    }
    policy coding-agent
{
    state = input

    while !state.approved limit 3 {
        implementation = Implementer(state)
        state = Reviewer(implementation)
    }

    return state
}
